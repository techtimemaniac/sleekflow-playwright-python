# SleekFlow login URL
BASE_URL=https://app.sleekflow.io/

# Browser configuration
BROWSER=chromium
HEADLESS=false
SLOW_MO=0

# Framework configuration
TIMEOUT=30000
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false
TRACE_ON_FAILURE=true
PARALLEL_WORKERS=1

# SleekFlow authentication tests
SLEEKFLOW_SIGNUP_ENABLED=false
SLEEKFLOW_GOOGLE_LOGIN_ENABLED=false
SLEEKFLOW_APPLE_LOGIN_ENABLED=false
SLEEKFLOW_LOGIN_USERNAME=
SLEEKFLOW_LOGIN_PASSWORD=
SLEEKFLOW_SIGNUP_USERNAME=
SLEEKFLOW_SIGNUP_PASSWORD=

# Reporting
ALLURE_RESULTS_DIR=reports/allure-results
ALLURE_REPORT_DIR=reports/allure-report
